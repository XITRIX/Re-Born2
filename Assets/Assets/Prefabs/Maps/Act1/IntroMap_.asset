      me, what is he even doing here?*","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":4530.0,"y":-173.0},"guid":"5ff685ce-1c66-4ebf-bf7d-00e18b82e888","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"80"},{"defaultValues":{"seconds":{"$content":2.0,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":9552.0,"y":-188.0},"guid":"eddfb2a1-6874-4672-ab56-0c626af65e14","$version":"A","$type":"Unity.VisualScripting.WaitForSecondsUnit","$id":"83"},{"chainable":false,"parameterNames":["routine"],"member":{"name":"RunCoroutine","parameterTypes":["System.Collections.IEnumerator"],"targetType":"GlobalDirector","targetTypeName":"GlobalDirector","$version":"A"},"defaultValues":{},"position":{"x":-1691.0,"y":-124.0},"guid":"e34f5b5c-f60e-4028-ac3b-e90062de0c6a","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"85"},{"nest":{"source":"Macro","macro":30,"embed":null},"defaultValues":{"Char":{"$content":31,"$type":"UnityEngine.Object"},"Message":{"$content":"...","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":3276.0,"y":-165.0},"guid":"6b58e517-1e5b-4b42-8867-49757076f81f","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"89"},{"defaultValues":{"Name":{"$content":32,"$type":"UnityEngine.Object"},"Message":{"$content":"Sorry,
      I am late for a meeting. That is all for today. Goodbye!","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-2088.0,"y":-144.0},"guid":"dc895bfc-eae2-4a59-a536-8f28b51708fa","$version":"A","$type":"VSMessageCharUnit","$id":"92"},{"chainable":false,"parameterNames":["routine"],"member":{"name":"RunCoroutine","parameterTypes":["System.Collections.IEnumerator"],"targetType":"GlobalDirector","targetTypeName":"GlobalDirector","$version":"A"},"defaultValues":{},"position":{"x":-4580.0,"y":-136.0},"guid":"d54fd599-20d6-46b3-b279-5b39bd6dfd69","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"94"},{"nest":{"source":"Macro","macro":33,"embed":null},"defaultValues":{"Char":{"$content":34,"$type":"UnityEngine.Object"},"Message":{"$content":"Want
