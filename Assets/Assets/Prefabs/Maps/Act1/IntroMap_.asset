      is all from me, handing it back","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-1192.0,"y":-119.0},"guid":"f28862dd-2342-4d30-abd5-c26348e1f644","$version":"A","$type":"VSMessageCharUnit","$id":"64"},{"nest":{"source":"Macro","macro":22,"embed":null},"defaultValues":{"Char":{"$content":23,"$type":"UnityEngine.Object"},"Message":{"$content":"It
      is impossible to work. Kirill bought up every game engine and made them private.
      Every graphics API is buried under so many licenses that it is easier to list
      what you are allowed to do with them than what is forbidden.","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":2373.0,"y":-166.0},"guid":"e83de637-7a81-4d57-8a22-289a88c8e9ca","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"66"},{"defaultValues":{"seconds":{"$content":0.0,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-6808.0,"y":-190.0},"guid":"9ab398b4-ba1f-4fed-9e24-d92cdcf21a68","$version":"A","$type":"Unity.VisualScripting.WaitForSecondsUnit","$id":"69"},{"nest":{"source":"Macro","macro":24,"embed":null},"defaultValues":{"ID":{"$content":"Hidelili","$type":"System.String"}},"position":{"x":5491.0,"y":799.0},"guid":"92aec4de-498f-45dd-9c56-06e045173a1a","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"71"},{"nest":{"source":"Macro","macro":25,"embed":null},"defaultValues":{"ID":{"$content":"","$type":"System.String"}},"position":{"x":4775.0,"y":767.0},"guid":"a6584ca6-851f-474c-afae-d3571994c331","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"74"},{"nest":{"source":"Macro","macro":26,"embed":null},"defaultValues":{"Char":{"$content":27,"$type":"UnityEngine.Object"},"Message":{"$content":"Come
      on, it is because of all these monopolies his house was seized for debt. Let
