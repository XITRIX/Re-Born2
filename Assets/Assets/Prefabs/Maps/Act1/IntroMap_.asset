      whole year has already passed","$type":"System.String"},{"$content":"Those
      events feel like some kind of dream","$type":"System.String"},{"$content":"Only
      the reflection in the mirror reminds me that it really happened","$type":"System.String"}],"$type":"Unity.VisualScripting.AotList"},"defaultValues":{},"position":{"x":6138.0,"y":983.0},"guid":"08444b1d-28d5-44de-95e3-296e7e07c7bf","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"101"},{"chainable":false,"parameterNames":["character","position","presentationType","flipped","seconds"],"member":{"name":"ShowCharacter","parameterTypes":["CharacterScriptableObject","UnityEngine.Vector2","UIDialogMessage+PresentationType","System.Boolean","System.Single"],"targetType":"UIDialogMessage","targetTypeName":"UIDialogMessage","$version":"A"},"defaultValues":{"%character":{"$content":35,"$type":"UnityEngine.Object"},"%position":{"x":0.5,"y":0.0,"$type":"UnityEngine.Vector2"},"%presentationType":{"$content":"RightSlide","$type":"UIDialogMessage+PresentationType"},"%flipped":{"$content":false,"$type":"System.Boolean"},"%seconds":{"$content":1.0,"$type":"System.Single"}},"position":{"x":617.0,"y":17.0},"guid":"3758fde0-79f5-455f-80db-bc24815f2927","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"104"},{"type":"Unity.VisualScripting.AotList","value":{"$content":[{"$content":"Attention!
      We have breaking news. A report just came in about who will inherit Elon Musk''s
      entire fortune!","$type":"System.String"},{"$content":"That person will be
      none other than the billionaire and playboy you all know, Kirill Vinogradov!","$type":"System.String"},{"$content":"As
      you all know, he owns PyCorp, which has brought companies such as NVidia, Unity
      Tec, Epic Games, and many other game development companies under its wing.","$type":"System.String"},{"$content":"We
      have a unique opportunity to interview Kirill live on air. Switching over now.","$type":"System.String"}],"$type":"Unity.VisualScripting.AotList"},"defaultValues":{},"position":{"x":-6451.0,"y":15.0},"guid":"d59d72fc-11f2-4daf-82e4-7527ee0d4635","$version":"A","$type":"Unity.VisualScripting.Literal","$id":"108"},{"chainable":false,"parameterNames":["character","presentationType","flipped","seconds"],"member":{"name":"HideCharacter","parameterTypes":["CharacterScriptableObject","UIDialogMessage+PresentationType","System.Boolean","System.Single"],"targetType":"UIDialogMessage","targetTypeName":"UIDialogMessage","$version":"A"},"defaultValues":{"%character":{"$content":36,"$type":"UnityEngine.Object"},"%presentationType":{"$content":"LeftSlide","$type":"UIDialogMessage+PresentationType"},"%flipped":{"$content":true,"$type":"System.Boolean"},"%seconds":{"$content":1.0,"$type":"System.Single"}},"position":{"x":7921.0,"y":10.0},"guid":"d4d393e3-fbc9-4182-af85-60e3d73d70ab","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"111"},{"defaultValues":{"Name":{"$content":37,"$type":"UnityEngine.Object"},"Message":{"$content":"AAAAAAAAAAAAAAAA!!!!","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":4483.0,"y":491.0},"guid":"c32e5822-bf07-415a-b57f-3787928e0eec","$version":"A","$type":"VSMessageCharUnit","$id":"115"},{"nest":{"source":"Macro","macro":38,"embed":null},"defaultValues":{"Image":{"$content":39,"$type":"UnityEngine.Object"},"Seconds":{"$content":2.0,"$type":"System.Single"},"NeedWait":{"$content":true,"$type":"System.Boolean"}},"position":{"x":-6000.0,"y":-189.0},"guid":"355d428a-126f-4bca-80d9-c14ae01b9491","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"117"},{"chainable":false,"parameterNames":["volume"],"member":{"name":"SetBackgroundAudioVolume","parameterTypes":["System.Single"],"targetType":"GlobalDirector","targetTypeName":"GlobalDirector","$version":"A"},"defaultValues":{"%volume":{"$content":0.5,"$type":"System.Single"}},"position":{"x":-32.0,"y":-145.0},"guid":"549a42bd-d6e0-49ca-b658-5dead422c161","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"120"},{"defaultValues":{"Name":{"$content":40,"$type":"UnityEngine.Object"},"Message":{"$content":"Some
      companies had the best writers, others had artists and programmers. The best
      way to optimize a game for specific hardware is to make that hardware yourself,
      so I bought NVidia. That is how we got to where we are now.","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":-2483.0,"y":-147.0},"guid":"1cb15018-c345-48f2-b7f5-183f87759e25","$version":"A","$type":"VSMessageCharUnit","$id":"124"},{"nest":{"source":"Macro","macro":41,"embed":null},"defaultValues":{"Char":{"$content":42,"$type":"UnityEngine.Object"},"Message":{"$content":"Try
      making your own... and there is the catch: he owns the companies that make
      the hardware. Try building something of your own and you will immediately get
      a court summons.","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":2681.0,"y":-166.0},"guid":"991c6e27-0125-4903-8b5a-a875d1a28ce7","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"126"},{"nest":{"source":"Macro","macro":43,"embed":null},"defaultValues":{},"position":{"x":8226.0,"y":-185.0},"guid":"74254c37-931f-40ef-9a1a-4c46936260e5","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"129"},{"defaultValues":{"Name":{"$content":44,"$type":"UnityEngine.Object"},"Message":{"$content":"Screw
