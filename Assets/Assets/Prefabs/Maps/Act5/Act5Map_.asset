  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":"Act5Map","summary":null,"pan":{"x":5251.769,"y":107.4949},"zoom":1.0,"elements":[{"coroutine":true,"defaultValues":{},"position":{"x":-498.0,"y":-46.0},"guid":"7ae096bb-6351-4445-8e1f-4a1af8ca3510","$version":"A","$type":"Unity.VisualScripting.Start","$id":"9"},{"nest":{"source":"Macro","macro":0,"embed":null},"defaultValues":{"Image":null,"Seconds":{"$content":3.0,"$type":"System.Single"},"NeedWait":{"$content":true,"$type":"System.Boolean"}},"position":{"x":5056.0,"y":-54.0},"guid":"0c860ae6-9f38-4978-8224-4be6830e7f28","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"11"},{"chainable":false,"parameterNames":["targetColor","seconds"],"member":{"name":"SetBackstageColor","parameterTypes":["UnityEngine.Color","System.Single"],"targetType":"UIDialogMessage","targetTypeName":"UIDialogMessage","$version":"A"},"defaultValues":{"%targetColor":{"r":0.0,"g":0.0,"b":0.0,"a":0.0,"$type":"UnityEngine.Color"},"%seconds":{"$content":2.0,"$type":"System.Single"}},"position":{"x":5369.0,"y":171.0},"guid":"dc084c0f-8728-425c-8811-d3553ae708e5","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"14"},{"defaultValues":{"seconds":{"$content":2.0,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":4439.0,"y":-53.0},"guid":"869120ae-db46-4c0c-bc4d-b25ad9775c72","$version":"A","$type":"Unity.VisualScripting.WaitForSecondsUnit","$id":"18"},{"nest":{"source":"Macro","macro":1,"embed":null},"defaultValues":{"Char":{"$content":2,"$type":"UnityEngine.Object"},"Message":{"$content":"No problem! Your back is in safe hands!","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":4109.0,"y":-71.0},"guid":"02691e50-c3a0-448d-9693-259fe3d23570","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"20"},{"nest":{"source":"Macro","macro":3,"embed":null},"defaultValues":{"Character":{"$content":4,"$type":"UnityEngine.Object"},"Position":{"x":0.0,"y":0.0,"$type":"UnityEngine.Vector2"},"Presentation Type":{"$content":"Fade","$type":"UIDialogMessage+PresentationType"},"Flipped":{"$content":false,"$type":"System.Boolean"},"Seconds":{"$content":2.0,"$type":"System.Single"},"NeedWait":{"$content":true,"$type":"System.Boolean"}},"position":{"x":927.0,"y":-308.0},"guid":"4647f136-327e-480e-9eff-52c4985a8455","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"23"},{"nest":{"source":"Macro","macro":5,"embed":null},"defaultValues":{"Char":{"$content":6,"$type":"UnityEngine.Object"},"Message":{"$content":"A taxi driver once is a taxi driver forever! When I saw you were looking for a car, I canceled my ride and rushed over to you!","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":3396.0,"y":-62.0},"guid":"b0295aa6-70c3-46a3-a0c8-a5a5ee815647","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"26"},{"nest":{"source":"Macro","macro":7,"embed":null},"defaultValues":{"Char":{"$content":8,"$type":"UnityEngine.Object"},"Message":{"$content":"You know, when I ordered a taxi, you were the last person I expected to see here.","$type":"System.String"},"HideFace":{"$content":true,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":3068.0,"y":-61.0},"guid":"c82e6b7d-9260-4af7-af25-94169bc47bbd","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"29"},{"nest":{"source":"Macro","macro":9,"embed":null},"defaultValues":{"Char":{"$content":10,"$type":"UnityEngine.Object"},"Message":{"$content":"Why so thoughtful, bro?","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":2715.0,"y":-58.0},"guid":"b1197f42-2a95-4b09-972e-de46a960f50d","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"32"},{"nest":{"source":"Macro","macro":11,"embed":null},"defaultValues":{"Char":{"$content":12,"$type":"UnityEngine.Object"},"Message":{"$content":"I am not really thrilled about the crawling-through-vents part.","$type":"System.String"},"HideFace":{"$content":true,"$type":"System.Boolean"},"HideName":{"$content":true,"$type":"System.Boolean"}},"position":{"x":2335.0,"y":-57.0},"guid":"a1688cd8-3307-443e-a33f-b16da7b05428","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"35"},{"nest":{"source":"Macro","macro":13,"embed":null},"defaultValues":{"Wait":{"$content":true,"$type":"System.Boolean"}},"position":{"x":5406.0,"y":-27.0},"guid":"c207d0f7-17da-41ad-b913-6ef82417eb7d","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"38"},{"nest":{"source":"Macro","macro":14,"embed":null},"defaultValues":{"Char":{"$content":15,"$type":"UnityEngine.Object"},"Message":{"$content":"You can sleep. I will wake you up when we are getting close.","$type":"System.String"},"HideFace":{"$content":false,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":4676.0,"y":-58.0},"guid":"d42af0e8-b22a-466e-a112-c2283f003798","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"41"},{"defaultValues":{"seconds":{"$content":4.0,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":44.0,"y":-64.0},"guid":"5bb261f3-59e3-4d53-9dff-e15ebbf8bc17","$version":"A","$type":"Unity.VisualScripting.WaitForSecondsUnit","$id":"44"},{"nest":{"source":"Macro","macro":16,"embed":null},"defaultValues":{"Image":{"$content":17,"$type":"UnityEngine.Object"},"Seconds":{"$content":2.0,"$type":"System.Single"},"NeedWait":{"$content":false,"$type":"System.Boolean"}},"position":{"x":284.0,"y":-51.0},"guid":"6a58f81a-02e9-4028-9ae2-c96d59b540d5","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"46"},{"nest":{"source":"Macro","macro":18,"embed":null},"defaultValues":{"Char":{"$content":19,"$type":"UnityEngine.Object"},"Message":{"$content":"I really did receive the letter...","$type":"System.String"},"HideFace":{"$content":true,"$type":"System.Boolean"},"HideName":{"$content":true,"$type":"System.Boolean"}},"position":{"x":1305.0,"y":-59.0},"guid":"06faed94-954d-4821-9d58-ad612a13043d","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"49"},{"nest":{"source":"Macro","macro":20,"embed":null},"defaultValues":{"Wait":{"$content":true,"$type":"System.Boolean"}},"position":{"x":771.0,"y":136.0},"guid":"64130f96-5a6e-4aa1-8dfb-3561277a461b","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"52"},{"chainable":false,"parameterNames":["targetColor","seconds"],"member":{"name":"SetBackstageColor","parameterTypes":["UnityEngine.Color","System.Single"],"targetType":"UIDialogMessage","targetTypeName":"UIDialogMessage","$version":"A"},"defaultValues":{"%targetColor":{"r":0.0,"g":0.0,"b":0.0,"a":0.0,"$type":"UnityEngine.Color"},"%seconds":{"$content":2.0,"$type":"System.Single"}},"position":{"x":742.0,"y":333.0},"guid":"925f2523-5b15-44b8-93ef-2a6d58e8a65e","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"55"},{"chainable":false,"parameterNames":["targetColor"],"member":{"name":"SetBackstageColor","parameterTypes":["UnityEngine.Color"],"targetType":"UIDialogMessage","targetTypeName":"UIDialogMessage","$version":"A"},"defaultValues":{"%targetColor":{"r":0.0,"g":0.0,"b":0.0,"a":1.0,"$type":"UnityEngine.Color"}},"position":{"x":-284.0,"y":-50.0},"guid":"6958df72-1a0f-43fb-b604-13264d6fe624","$version":"A","$type":"Unity.VisualScripting.InvokeMember","$id":"59"},{"nest":{"source":"Macro","macro":21,"embed":null},"defaultValues":{"Char":{"$content":22,"$type":"UnityEngine.Object"},"Message":{"$content":"It said I had to arrive at SkyTower in the middle of the night, and it included a map with instructions for getting past the security cameras and guards...","$type":"System.String"},"HideFace":{"$content":true,"$type":"System.Boolean"},"HideName":{"$content":true,"$type":"System.Boolean"}},"position":{"x":1659.0,"y":-60.0},"guid":"b4a0b28c-aa20-48c9-b2ce-0036b3f0db2a","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"63"},{"nest":{"source":"Macro","macro":23,"embed":null},"defaultValues":{"Char":{"$content":24,"$type":"UnityEngine.Object"},"Message":{"$content":"Thanks! Since it worked out this way, can I ask you to stay somewhere near SkyTower and keep an eye on things? If you see anything suspicious, call me right away. And if something goes wrong, at least I will not be left without a car.","$type":"System.String"},"HideFace":{"$content":true,"$type":"System.Boolean"},"HideName":{"$content":false,"$type":"System.Boolean"}},"position":{"x":3765.0,"y":-64.0},"guid":"e3b95280-b3c3-488c-925c-f87825a2ee26","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"66"},{"nest":{"source":"Macro","macro":25,"embed":null},"defaultValues":{"Char":{"$content":26,"$type":"UnityEngine.Object"},"Message":{"$content":"My target is the laboratory, where I am supposed to meet someone...","$type":"System.String"},"HideFace":{"$content":true,"$type":"System.Boolean"},"HideName":{"$content":true,"$type":"System.Boolean"}},"position":{"x":1997.0,"y":-63.0},"guid":"8eafd86d-2236-411c-8f66-fc4b856800ab","$version":"A","$type":"Unity.VisualScripting.SubgraphUnit","$id":"69"},{"sourceUnit":{"$ref":"9"},"sourceKey":"trigger","destinationUnit":{"$ref":"59"},"destinationKey":"enter","guid":"9fc4b34e-e08c-4324-80f5-ec04166c3e69","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"59"},"sourceKey":"exit","destinationUnit":{"$ref":"44"},"destinationKey":"enter","guid":"facdba13-68a6-433b-84b0-da237a9113d3","$type":"Unity.VisualScri