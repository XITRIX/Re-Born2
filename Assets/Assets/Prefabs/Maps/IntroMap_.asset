      \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 PyCorp \u043a\u043e\u0442\u043e\u0440\u0430\u044f
      \u043e\u0431\u044a\u0435\u043b\u0438\u043d\u0438\u043b\u0430 \u043f\u043e\u0434
      \u0441\u0432\u043e\u0438\u043c \u043a\u0440\u044b\u043b\u043e\u043c \u0442\u0430\u043a\u0438\u0435
      \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u043a\u0430\u043a NVidia,
